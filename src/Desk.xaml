<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F2F5F8" UseLayoutRounding="True">
 <Grid.Resources>
  <SolidColorBrush x:Key="Ink" Color="#203249"/>
  <SolidColorBrush x:Key="Muted" Color="#65758A"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#263B50"/><Setter Property="BorderBrush" Value="#D9E2EC"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Margin" Value="0,0,6,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#278679"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#176B63"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#176B63"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#CBD7E3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#203249"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="7,5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="Foreground" Value="#203249"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabSurface" CornerRadius="6" Background="#F4F7FA" Margin="0,0,4,6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E0F1EC"/><Setter Property="Foreground" Value="#145E55"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="0,0,0,1" Padding="18,10">
  <DockPanel>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LoopDesk" FontSize="23" FontWeight="Bold"/><TextBlock Text="  1.1" Foreground="#65758A" VerticalAlignment="Center" FontSize="12"/></StackPanel>
   <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
    <TextBlock x:Name="State" Text="● 준비됨" VerticalAlignment="Center" Foreground="#176B63" Margin="10,0,18,4"/>
    <Button x:Name="Manage" Content="관리 ⋯" Margin="0,0,6,0"/><Button x:Name="Help" Content="사용법" Margin="0"/>
   </WrapPanel>
  </DockPanel>
 </Border>
 <Border Grid.Row="1" Padding="18,12,12,5">
  <DockPanel>
   <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button x:Name="Play" Content="▶ 실행 · F9" Style="{StaticResource Primary}" MinWidth="125"/><Button x:Name="Pause" Content="일시정지"/><Button x:Name="Stop" Content="■ 정지" Foreground="#A42C3B"/></WrapPanel>
   <WrapPanel><Button x:Name="Record" Content="● 녹화 · F6" Background="#FFF0F1" Foreground="#A32A3A" BorderBrush="#F0DADD"/><Button x:Name="EndRecord" Content="녹화 종료"/><Button x:Name="DirectInput" Content="+ 키·마우스 입력" Background="White" FontWeight="SemiBold"/><Button x:Name="AddStep" Content="다른 동작 ▾"/></WrapPanel>
  </DockPanel>
 </Border>
 <Grid x:Name="Workspace" Grid.Row="2" Margin="14,0,14,10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="174" MinWidth="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="290" MinWidth="270"/></Grid.ColumnDefinitions>
  <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#DFE6EE" BorderThickness="1">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,10"><TextBlock Text="내 매크로" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="AddMacro" Content="+" DockPanel.Dock="Right" HorizontalAlignment="Right" ToolTip="새 매크로" Padding="9,2" MinHeight="28" Margin="0"/></DockPanel><TextBox x:Name="Search" ToolTip="매크로 이름 검색" AutomationProperties.Name="매크로 이름 검색" Margin="0,0,0,8"/></StackPanel>
    <ListBox x:Name="Library" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
  <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12" BorderBrush="#DFE6EE" BorderThickness="1">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <DockPanel><Button x:Name="EditTools" DockPanel.Dock="Right" Content="편집 ⋯" HorizontalAlignment="Right"/><TextBlock x:Name="Title" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="Count" Style="{StaticResource Small}" Margin="0,3,0,12"/>
    </StackPanel>
    <Grid>
     <DataGrid x:Name="Steps" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF3" RowBackground="White" AlternatingRowBackground="#F8FAFC" AlternationCount="2" RowHeight="46" Background="White" BorderThickness="0" EnableRowVirtualization="True">
      <DataGrid.Resources>
       <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="7,9"/><Setter Property="Background" Value="#F1F5F8"/><Setter Property="Foreground" Value="#54667C"/><Setter Property="FontSize" Value="12"/></Style>
       <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/></Style>
       <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,0"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="32" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="동작" Binding="{Binding Summary}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="반복" Binding="{Binding Repeat}" Width="60" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="대기" Binding="{Binding Delay}" Width="76" ElementStyle="{StaticResource CellText}"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
      <TextBlock Text="첫 동작을 만들어 볼까요?" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="녹화하거나, 키·마우스 입력을 추가하세요." Foreground="#65758A" Margin="0,10,0,16" HorizontalAlignment="Center"/>
      <Button x:Name="Example" Content="Q를 10번 입력하는 예제 열기" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Border>
  <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
  <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="12" BorderBrush="#DFE6EE" BorderThickness="1">
   <TabControl x:Name="Tabs" SelectedIndex="1" BorderThickness="0" Background="White">
    <TabItem Header="전체 반복"><DockPanel><StackPanel x:Name="SettingsFooter" DockPanel.Dock="Bottom"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Settings" Margin="0,2,6,0"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="동작"><DockPanel><StackPanel x:Name="EditorFooter" DockPanel.Dock="Bottom"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor" Margin="0,2,6,0"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="단축키"><DockPanel><StackPanel x:Name="HotkeysFooter" DockPanel.Dock="Bottom"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Hotkeys" Margin="0,2,6,0"/></ScrollViewer></DockPanel></TabItem>
   </TabControl>
  </Border>
 </Grid>
 <Border x:Name="InputDock" Grid.Row="3" Visibility="Collapsed" Margin="14,0,14,10" Background="White" BorderBrush="#A9CEC5" BorderThickness="1" CornerRadius="10" Padding="12">
  <ContentControl x:Name="InputContent"/>
 </Border>
 <Border Grid.Row="4" Background="#E8EEF3" Padding="16,7">
  <DockPanel><TextBlock x:Name="EmergencyLabel" DockPanel.Dock="Right" Text="긴급 정지 Ctrl+Alt+Esc" FontSize="12" Foreground="#426158" Margin="16,0,0,0"/><TextBlock x:Name="Message" Text="준비됨" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
 </Border>
 <StackPanel Visibility="Collapsed">
  <Button x:Name="Duplicate"/><Button x:Name="DeleteMacro"/><Button x:Name="Import"/><Button x:Name="Export"/>
  <Button x:Name="CopyStep"/><Button x:Name="DeleteStep"/><Button x:Name="MoveUp"/><Button x:Name="MoveDown"/><Button x:Name="Undo"/><Button x:Name="ReplaceSteps"/>
  <Button x:Name="Test"/><Button x:Name="Preview"/><Button x:Name="Random"/><Button x:Name="History"/>
 </StackPanel>
</Grid>
